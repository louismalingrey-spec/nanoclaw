# Dependencies
node_modules/
.npm-cache/
# pnpm content-addressable store (created when running in sandbox mode)
.pnpm-store/
# Build output
dist/

# Local data & auth
store/
data/
logs/

# Groups - per-installation state, not tracked
groups/*

# Composer-managed CLAUDE.md artifacts (regenerated every spawn) and
# per-group memory (CLAUDE.local.md) must never be committed.
**/CLAUDE.local.md
**/.claude-shared.md
**/.claude-fragments/

# Secrets
*.keys.json
.env
.env*

# Temp files
.tmp-*

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/

agents-sdk-docs

# Local Mac-dev pollution — never tracked, never deployed.
#   .claude/worktrees/  : Conductor / Claude Code session worktrees (per-session, ephemeral)
#   leads-dashboard/    : sibling Vercel project that sometimes lives inside this dir during dev
#   my-automations/     : personal one-off automation scripts unrelated to NanoClaw
.claude/worktrees/
leads-dashboard/
my-automations/
